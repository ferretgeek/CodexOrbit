<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="CodexQuota.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown" xmlns:codexquota="clr-namespace:CodexQuota;assembly=CodexOrbit">
  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
      <FontFamily x:Key="NumFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
      <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
      <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource ThMenuText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="ContextMenu.HasDropShadow" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border Margin="9" Background="{DynamicResource ThMenuBg}" BorderBrush="{DynamicResource ThMenuBorder}" BorderThickness="1" CornerRadius="10" Padding="5">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
                </UIElement.Effect>
                <ItemsPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Separator}" TargetType="{x:Type Separator}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Border Height="1" Background="{DynamicResource ThMenuSeparator}" Margin="10,4,10,4" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ThMenuText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Border Name="Bg" CornerRadius="6" Background="#00FFFFFF" Padding="9,7,8,7" Margin="1,1,1,1" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Name="IconHost" ContentSource="Icon" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  <TextBlock Name="CheckGlyph" Text="" FontSize="11" Foreground="{DynamicResource ThMenuAccent}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" FontFamily="{StaticResource GlyphFont}" />
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" Margin="3,0,12,0" />
                  <TextBlock Name="Arrow" Grid.Column="2" Text="" FontSize="10" Foreground="{DynamicResource ThMenuTextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" FontFamily="{StaticResource GlyphFont}" />
                  <Popup Name="SubPopup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-12" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Margin="9" Background="{DynamicResource ThMenuBg}" BorderBrush="{DynamicResource ThMenuBorder}" BorderThickness="1" CornerRadius="10" Padding="5">
                      <UIElement.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" />
                      </UIElement.Effect>
                      <ItemsPresenter />
                    </Border>
                  </Popup>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="MenuItem.Role" Value="SubmenuHeader">
                  <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="MenuItem.IsChecked" Value="True">
                  <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="MenuItem.Icon" Value="{x:Null}">
                  <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="MenuItem.IsHighlighted" Value="True">
                  <Setter TargetName="Bg" Value="{DynamicResource ThMenuHover}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>