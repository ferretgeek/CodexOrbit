<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CodexQuota.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Orbit" Width="120" Height="120" MinWidth="90" MinHeight="90" MaxWidth="480" MaxHeight="480" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False" FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns:codexquota="clr-namespace:CodexQuota;assembly=CodexOrbit" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Closing="Window_Closing">
  <Grid Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5" Background="#00FFFFFF" ToolTipService.IsEnabled="False" MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseRightButtonUp="Root_MouseRightButtonUp">
    <FrameworkElement.ToolTip>
      <ToolTip Name="DetailToolTip" Placement="Mouse" HorizontalOffset="14" VerticalOffset="10" Background="#00FFFFFF" BorderThickness="0" Padding="0" HasDropShadow="False" StaysOpen="True">
        <Border Background="{DynamicResource ThTipBg}" BorderBrush="{DynamicResource ThTipBorder}" BorderThickness="1" CornerRadius="10" Padding="13,11" Margin="7">
          <UIElement.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" />
          </UIElement.Effect>
          <StackPanel Width="232">
            <DockPanel LastChildFill="False">
              <TextBlock Text="Codex Orbit" Foreground="{DynamicResource ThTextHi}" FontSize="13" FontWeight="SemiBold" DockPanel.Dock="Left" />
              <TextBlock Name="PlanText" Text="" Foreground="{DynamicResource ThTextFaint}" FontSize="10.5" VerticalAlignment="Center" DockPanel.Dock="Right" />
            </DockPanel>
            <Border Height="1" Background="{DynamicResource ThMenuSeparator}" Margin="0,8,0,7" />
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="同步状态" Foreground="{DynamicResource ThTextFaint}" FontSize="11" />
              <TextBlock Name="SyncStatusText" Grid.Column="1" Text="正在读取" Foreground="{DynamicResource ThOk}" FontSize="11" TextAlignment="Right" />
            </Grid>
            <Grid Name="ShortDetailRow" Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="ShortDetailLabel" Text="5 小时" Foreground="{DynamicResource ThAccentShort}" FontSize="11" />
              <TextBlock Name="ShortDetailText" Grid.Column="1" Text="等待数据" Foreground="{DynamicResource ThTextLo}" FontSize="11" TextAlignment="Right" />
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="WeekDetailLabel" Text="周额度" Foreground="{DynamicResource ThAccentWeek}" FontSize="11" />
              <TextBlock Name="WeekDetailText" Grid.Column="1" Text="等待数据" Foreground="{DynamicResource ThTextLo}" FontSize="11" TextAlignment="Right" />
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="最后同步" Foreground="{DynamicResource ThTextFaint}" FontSize="11" />
              <TextBlock Name="LastSyncText" Grid.Column="1" Text="--" Foreground="{DynamicResource ThTextFaint}" FontSize="11" TextAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>
      </ToolTip>
    </FrameworkElement.ToolTip>
    <UIElement.RenderTransform>
      <ScaleTransform x:Name="RootScale" ScaleX="0.965" ScaleY="0.965" />
    </UIElement.RenderTransform>
    <Canvas Name="GaugeCanvas" IsHitTestVisible="False">
      <Ellipse Name="CenterBackdrop" Fill="{DynamicResource ThRingBackdrop}">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource ThGlowColor}" />
        </UIElement.Effect>
      </Ellipse>
      <Ellipse Name="WeekTrack" Stroke="{DynamicResource ThTrack}" Fill="#00FFFFFF" />
      <Ellipse Name="ShortTrack" Stroke="{DynamicResource ThTrack}" Fill="#00FFFFFF" />
      <Path Name="WeekRing" Stroke="{DynamicResource ThWeekRing}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      <Path Name="ShortRing" Stroke="{DynamicResource ThShortRing}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      <Ellipse Name="EdgeRim" Stroke="{DynamicResource ThRingEdge}" Fill="#00FFFFFF" />
    </Canvas>
    <StackPanel Name="ValuePanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="ValuePanelShift" Y="0" />
      </UIElement.RenderTransform>
      <TextBlock Name="WeekPercent" Text="7d --" Foreground="{DynamicResource ThAccentWeek}" FontFamily="{StaticResource NumFont}" FontSize="16.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Name="ShortPercent" Text="5h --" Foreground="{DynamicResource ThAccentShort}" FontFamily="{StaticResource NumFont}" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0.5,0,0" />
      <TextBlock Name="ResetText" Text="等待数据" Foreground="{DynamicResource ThTextFaint}" FontSize="9.5" HorizontalAlignment="Center" Margin="0,1.5,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Grid>
</Window>
