<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CodexQuota.MiniStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Orbit Mini" Width="256" Height="96" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled" UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns:codexquota="clr-namespace:CodexQuota;assembly=CodexOrbit">
  <Grid Name="Root" Opacity="0" ClipToBounds="True" ToolTipService.IsEnabled="False" MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseRightButtonUp="Root_MouseRightButtonUp" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
    <UIElement.RenderTransform>
      <TranslateTransform x:Name="RootTranslate" Y="4" />
    </UIElement.RenderTransform>
    <FrameworkElement.ToolTip>
      <ToolTip x:Name="InfoToolTip" Background="#00FFFFFF" BorderThickness="0" Padding="0" Placement="Top" VerticalOffset="-10" HasDropShadow="False" StaysOpen="True">
        <Border Background="{DynamicResource ThTipBg}" BorderBrush="{DynamicResource ThTipBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="8">
          <UIElement.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
          </UIElement.Effect>
          <StackPanel MaxWidth="360">
            <TextBlock Name="DetailStatusText" Text="正在同步" Foreground="{DynamicResource ThOk}" FontSize="15" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
            <TextBlock Name="DetailValueText" Text="等待额度数据" Foreground="{DynamicResource ThTextLo}" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
          </StackPanel>
        </Border>
      </ToolTip>
    </FrameworkElement.ToolTip>
    <Grid Name="ExpandedContent" Width="256" Height="96" HorizontalAlignment="Left" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <Border Name="UnifiedShell" Height="84" Margin="6,0" VerticalAlignment="Center" CornerRadius="42" BorderThickness="1.5" Background="{DynamicResource ThSurface}" BorderBrush="{DynamicResource ThSurfaceBorder}" Padding="6,4,8,4" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <UIElement.Effect>
          <DropShadowEffect x:Name="UnifiedShadow" BlurRadius="16" ShadowDepth="1" Opacity="0.4" Color="{DynamicResource ThGlowColor}" />
        </UIElement.Effect>
        <Grid>
          <Border Name="UnifiedHover" CornerRadius="39" Background="{DynamicResource ThHoverOverlay}" Opacity="0" />
          <Border Name="PlanShimmer" CornerRadius="39" Opacity="0" IsHitTestVisible="False" ClipToBounds="True" />
          <StackPanel Name="ContentRow" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Name="PillShell" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,1,0" Visibility="Collapsed" MinWidth="100">
              <StackPanel Orientation="Horizontal">
                <TextBlock Name="ShortLabelText" Text="5h" Foreground="{DynamicResource ThTextLo}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
                <TextBlock Name="ShortValueText" Text="--" Foreground="{DynamicResource ThAccentShort}" FontFamily="{StaticResource NumFont}" FontSize="21" FontWeight="Bold" Margin="7,-1,0,0" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
              </StackPanel>
              <TextBlock Name="ShortResetText" Text="等待同步" Foreground="{DynamicResource ThTextLo}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
            </StackPanel>
            <Grid Name="GaugeShell" Width="75" Height="75" Margin="1,0,3,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
              <Canvas Width="75" Height="75" SnapsToDevicePixels="True">
                <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="70" Height="70" Stroke="{DynamicResource ThHandleTrack}" StrokeThickness="6.5" />
                <Path Name="GaugeProgressPath" StrokeThickness="6.5" Stroke="{DynamicResource ThWeekRing}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Name="GaugeValueText" Text="--" Foreground="{DynamicResource ThTextHi}" FontFamily="{StaticResource NumFont}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
                <TextBlock Name="GaugeLabelText" Text="同步" Foreground="{DynamicResource ThAccentWeek}" FontSize="12" FontWeight="SemiBold" Margin="0,-2,0,0" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
                <TextBlock Name="GaugeResetText" Text="等待同步" Foreground="{DynamicResource ThTextLo}" FontSize="8.5" FontWeight="SemiBold" Margin="0,0,0,0" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
              </StackPanel>
            </Grid>
            <Border Name="PlanDivider" Width="1.5" Height="42" Margin="2,0,8,0" VerticalAlignment="Center" Background="#55FFFFFF" Visibility="Collapsed" />
            <StackPanel Name="PlanBadgeShell" VerticalAlignment="Center" MinWidth="96" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Name="PlanGlyphText" Text="" FontFamily="{StaticResource GlyphFont}" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource ThAccentWeek}" Margin="0,0,6,0" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
                <TextBlock Name="PlanTitleText" Text="PRO 20×" FontFamily="{StaticResource NumFont}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource ThTextHi}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
              </StackPanel>
              <TextBlock Name="PlanSubText" Text="至尊 · 20 倍" FontSize="12" FontWeight="SemiBold" Margin="24,2,0,0" Foreground="{DynamicResource ThTextLo}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Name="CollapsedHandle" Width="48" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <Border CornerRadius="16" Background="{DynamicResource ThSurface}" BorderBrush="{DynamicResource ThSurfaceBorder}" BorderThickness="1.5" Padding="6,8">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Name="HandlePercentText" Text="--" Foreground="{DynamicResource ThTextHi}" FontFamily="{StaticResource NumFont}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
          <Border Width="16" Height="56" CornerRadius="8" Margin="0,6,0,0" Background="{DynamicResource ThHandleTrack}" HorizontalAlignment="Center">
            <Border Name="HandleProgress" Width="16" Height="36" VerticalAlignment="Bottom" CornerRadius="8" Background="{DynamicResource ThHandleFill}" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
